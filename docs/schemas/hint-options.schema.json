{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "HintOptions",
  "description": "Hint settings.",
  "type": "object",
  "properties": {
    "samples": {
      "description": "Random guesses at the hidden cards (ignored when nothing is hidden).",
      "default": 16,
      "type": "integer",
      "format": "uint32",
      "minimum": 0.0
    },
    "seed": {
      "default": 0,
      "type": "integer",
      "format": "uint64",
      "minimum": 0.0
    },
    "solve": {
      "description": "Search options for each guess. Its `max_states` is the budget for each guess.",
      "default": {
        "autoplay": true,
        "max_states": 100000,
        "shorten": true,
        "strategy": "auto"
      },
      "allOf": [
        {
          "$ref": "#/definitions/SolveOptions"
        }
      ]
    }
  },
  "definitions": {
    "SolveOptions": {
      "description": "Search limits and knobs.",
      "type": "object",
      "properties": {
        "autoplay": {
          "description": "Play provably safe foundation moves automatically (when the rules allow it).",
          "default": true,
          "type": "boolean"
        },
        "max_states": {
          "description": "Stop after visiting this many distinct positions.",
          "default": 2000000,
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "shorten": {
          "description": "Shorten winning lines by cutting out detours (default true).",
          "default": true,
          "type": "boolean"
        },
        "strategy": {
          "default": "auto",
          "allOf": [
            {
              "$ref": "#/definitions/Strategy"
            }
          ]
        },
        "timeout_ms": {
          "description": "Stop after this many milliseconds of wall-clock time (native targets only).",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0.0
        }
      }
    },
    "Strategy": {
      "description": "Search strategy.",
      "oneOf": [
        {
          "description": "Depth-first, heuristic ordering. Can prove unsolvability.",
          "type": "string",
          "enum": [
            "depth_first"
          ]
        },
        {
          "description": "Best-first by heuristic. Can also prove unsolvability, at a higher memory cost.",
          "type": "string",
          "enum": [
            "best_first"
          ]
        },
        {
          "description": "Best-first for a share of the budget, then depth-first with the rest.",
          "type": "string",
          "enum": [
            "auto"
          ]
        }
      ]
    }
  }
}
